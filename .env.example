# ===========================================
# Cerebras Anthropic Gateway - Configuration
# ===========================================

# ===========================================
# AUTHENTICATION MODES
# ===========================================
# This gateway supports TWO authentication modes:
#
# 1. PASSTHROUGH MODE (Recommended - like GLM/MiniMax):
#    - Leave GATEWAY_API_KEYS empty
#    - Users provide their own Cerebras API key directly
#    - The key they set as ANTHROPIC_AUTH_TOKEN IS their Cerebras key
#    - No CEREBRAS_API_KEY needed on server
#
# 2. GATEWAY KEYS MODE:
#    - Set GATEWAY_API_KEYS to a list of keys you issue to users
#    - Set CEREBRAS_API_KEY to your server's Cerebras key
#    - Server uses its own key for all Cerebras API calls
#
# For GLM/MiniMax style setup, use PASSTHROUGH MODE (option 1)

# ===========================================
# Cerebras API (Only required for Gateway Keys Mode)
# ===========================================
# Leave empty for passthrough mode
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=zai-glm-4.7

# ===========================================
# Gateway Authentication
# ===========================================
# For PASSTHROUGH MODE (recommended): Leave this EMPTY
# For GATEWAY KEYS MODE: Set comma-separated list of valid keys
GATEWAY_API_KEYS=

# Environment
ENVIRONMENT=production

# ===========================================
# Optional Settings (defaults work fine)
# ===========================================

# Rate Limiting (disable if no Redis available)
RATE_LIMIT_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Response Caching (disable if no Redis available)
CACHE_ENABLED=false

# Server
HOST=0.0.0.0
PORT=8080

# ===========================================
# Security Settings
# ===========================================

# CORS Origins (comma-separated list of allowed origins)
# Use "*" for development only. For production, specify exact origins:
# Example: https://cursor.so,https://claude.ai,https://your-domain.com
CORS_ORIGINS=*

# ===========================================
# Connection Timeouts
# ===========================================

# Total request timeout in seconds (default: 120)
CEREBRAS_TIMEOUT_SECONDS=120.0

# Connection timeout in seconds (default: 10)
CEREBRAS_CONNECT_TIMEOUT_SECONDS=10.0

# Maximum retry attempts for failed requests (default: 3)
CEREBRAS_MAX_RETRIES=3

# ===========================================
# Context Length Management
# ===========================================
# Cerebras zai-glm-4.7 has 128K token limit vs Claude's 200K
# These settings help prevent "context length exceeded" errors

# Target token limit (aggressive buffer below 131K limit, default: 100000)
# Using 100K to leave ~30K buffer for tokenizer estimation differences
CONTEXT_LIMIT_TOKENS=100000

# Max characters per tool result (default: 30000, 0 = no limit)
# File reads and tool outputs are truncated to this length
MAX_TOOL_RESULT_CHARS=30000

# Enable automatic truncation (default: true)
# Set to false to get raw errors instead of auto-truncating
TRUNCATION_ENABLED=true

# Truncation strategy: "truncate", "warn", or "error" (default: truncate)
# - truncate: Auto-cut long content with notice
# - warn: Log warning but keep full content (may cause errors)
# - error: Fail immediately if content too long
TRUNCATION_STRATEGY=truncate
