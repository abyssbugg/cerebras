# ===========================================
# Cerebras Anthropic Gateway - Configuration
# ===========================================

# REQUIRED: Cerebras API
CEREBRAS_API_KEY=your-cerebras-api-key
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=zai-glm-4.7

# REQUIRED: Gateway API Keys (comma-separated)
# These are the keys your clients will use to authenticate
GATEWAY_API_KEYS=your-gateway-key-1,your-gateway-key-2

# Environment
ENVIRONMENT=production

# ===========================================
# Optional Settings (defaults work fine)
# ===========================================

# Rate Limiting (disable if no Redis available)
RATE_LIMIT_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Response Caching (disable if no Redis available)
CACHE_ENABLED=false

# Server
HOST=0.0.0.0
PORT=8080
