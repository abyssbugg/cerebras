# ===========================================
# Files to EXCLUDE from GitHub
# ===========================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.python-version
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.env
.venv
env/
venv/

# IDE & Editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
logs/

# Secrets (NEVER commit these!)
.env
.env.local
.env.*.local

